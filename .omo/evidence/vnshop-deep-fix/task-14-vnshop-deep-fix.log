  minio-bootstrap:
    container_name: vnshop-minio-bootstrap
    depends_on:
      minio:
        condition: service_healthy
        required: true
    entrypoint:
      - /bin/sh
      - -c
      - |
        mc alias set local http://minio:9000 task14-minio-user task14-minio &&
        mc mb --ignore-existing local/vnshop-products local/vnshop-reviews local/vnshop-invoices local/vnshop-avatars &&
        mc mb --ignore-existing local/vnshop-video-uploads-tmp local/vnshop-videos-staging local/vnshop-videos &&
        printf '%s' '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"AWS":["*"]},"Action":["s3:GetObject"],"Resource":["arn:aws:s3:::vnshop-products/*"]}]}' > /tmp/vnshop-products-public.json &&
        mc anonymous set-json /tmp/vnshop-products-public.json local/vnshop-products &&
        printf '%s' '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"AWS":["*"]},"Action":["s3:GetObject"],"Resource":["arn:aws:s3:::vnshop-reviews/*"]}]}' > /tmp/vnshop-reviews-public.json &&
        mc anonymous set-json /tmp/vnshop-reviews-public.json local/vnshop-reviews &&
        printf '%s' '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"AWS":["*"]},"Action":["s3:GetObject"],"Resource":["arn:aws:s3:::vnshop-avatars/*"]}]}' > /tmp/vnshop-avatars-public.json &&
        mc anonymous set-json /tmp/vnshop-avatars-public.json local/vnshop-avatars &&
        printf '%s' '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"AWS":["*"]},"Action":["s3:GetObject"],"Resource":["arn:aws:s3:::vnshop-videos/*"]}]}' > /tmp/vnshop-videos-public.json &&
        mc anonymous set-json /tmp/vnshop-videos-public.json local/vnshop-videos &&
        # Auto-expire raw uploads after 24 h
        mc ilm rule add --expire-days 1 local/vnshop-video-uploads-tmp &&
        echo "minio buckets ready"
    image: minio/mc:RELEASE.2025-08-13T08-35-41Z
    networks:
      default: null
