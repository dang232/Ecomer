# VNShop — Environment configuration
#
# Copy this file to `.env` and fill in any values you want to override.
# Compose reads `.env` automatically. `.env` is gitignored; `.env.example` is
# the canonical, committed template.
#
# Defaults below match `docker compose --profile apps up` for a local dev box.
# Production overrides go through the same names but resolve to real hostnames
# and secrets sourced from your platform's secret manager.

# ---------------------------------------------------------------------------
# Frontend (Vite, baked into the SPA bundle at `docker compose build frontend`)
# ---------------------------------------------------------------------------
# These flow into Vite as VITE_* and are inlined into dist/. Browsers reach the
# gateway and Keycloak directly, so the URLs must be browser-resolvable
# (NOT in-network names like `api-gateway` or `keycloak`).
VITE_API_URL=http://localhost:8080
VITE_ALLOW_INSECURE_RUNTIME_CONFIG=true

# Runtime configuration origins. These local HTTP values are accepted only by
# the explicit local opt-in above; production must use canonical HTTPS origins.
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
# Keycloak remains internal; this origin is retained for optional broker/OIDC metadata.
AUTH_ORIGIN=http://localhost:8080
RUNTIME_CONFIG_ALLOW_INSECURE=true

# ---------------------------------------------------------------------------
# Gateway CORS (BE-7)
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. Local default covers the nginx-served SPA
# and the `vite dev` preview port. In production lock to the canonical origin.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Internal aggregated OpenAPI documentation
# ---------------------------------------------------------------------------
# The aggregate is served at /monitoring/openapi.json and /monitoring/docs
# through the gateway. Keep it behind the private network and admin role.
OPENAPI_ENABLED=true
OPENAPI_GATEWAY_SERVER_URL=http://localhost:8080
OPENAPI_DOCUMENT_VERSION=1.0.0
OPENAPI_REFRESH_INTERVAL_MS=300000
OPENAPI_FETCH_TIMEOUT_MS=3000
DISCOVERY_MODE=static
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Infrastructure Credentials
# ---------------------------------------------------------------------------
# Override these in production. Local-dev defaults match docker-compose.yml.
DB_PASSWORD=vnshop
REDIS_PASSWORD=vnshop123

# Unleash tokens. Generate environment-specific values; these are required by
# both the Unleash server bootstrap and user-service feature-flag client.
UNLEASH_DB_PASSWORD=unleash123
UNLEASH_ADMIN_API_TOKEN=*:*.replace-with-local-admin-token
UNLEASH_CLIENT_API_TOKEN=default:replace-with-local-client-token

# Kafka service account for user-service GDPR consumers.
KAFKA_USER_PASSWORD=replace-with-user-service-kafka-password
VNSHOP_PAYOUT_DESTINATION_KEY_V1=replace-with-32-byte-base64-key
VNSHOP_PAYOUT_DESTINATION_DEFAULT_KEY_VERSION=1

# Cursor signing keys. Required by product/search services; use unique random
# values per environment and rotate them with an explicit cursor invalidation plan.
VNSHOP_PRODUCT_CURSOR_SECRET=
VNSHOP_SEARCH_CURSOR_SECRET=
S3_BUCKET_PUBLIC=vnshop-videos

# ---------------------------------------------------------------------------
# Optional: Keycloak admin credentials
# ---------------------------------------------------------------------------
# Default `admin/admin` is fine for local dev. Override in any shared env.
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_ADMIN_API_CLIENT_SECRET=vnshop-admin-api-secret-dev

# ---------------------------------------------------------------------------
# Database passwords (CHANGE IN PRODUCTION)
# ---------------------------------------------------------------------------
# Shared password for all per-service postgres instances.
POSTGRES_PASSWORD=vnshop123
# Password for the TimescaleDB monitoring database.
MONITORING_DB_PASSWORD=monitoring
# MongoDB root password (used by mongo container and notification-service).
MONGO_ROOT_PASSWORD=vnshop123

# ---------------------------------------------------------------------------
# Object storage (product images, review photos, invoice PDFs)
# ---------------------------------------------------------------------------
# Two backends are wire-compatible: Cloudflare R2 (production) and MinIO
# (local-dev, runs as a sibling container). The Java services use the AWS S3
# SDK against either. Default values below resolve to the in-network MinIO.
#
# To switch to R2 in production, set OBJECT_STORAGE_PROFILE=R2 and override
# the endpoint/access-key/secret/bucket. R2 expects virtual-host-style
# addressing so flip path-style off too.
#
#   OBJECT_STORAGE_PROFILE=R2
#   OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   OBJECT_STORAGE_REGION=auto
#   OBJECT_STORAGE_ACCESS_KEY=<r2-access-key>
#   OBJECT_STORAGE_SECRET_KEY=<r2-secret-key>
#   OBJECT_STORAGE_BUCKET_PRODUCTS=vnshop-products
#   OBJECT_STORAGE_PATH_STYLE=false
#
#   INVOICE_STORAGE_PROFILE=R2
#   INVOICE_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   INVOICE_STORAGE_BUCKET=vnshop-invoices
#   INVOICE_STORAGE_PATH_STYLE=false
#
# Local-dev defaults (omit or leave commented out):
# OBJECT_STORAGE_ENABLED=true
# OBJECT_STORAGE_PROFILE=MINIO
# OBJECT_STORAGE_ENDPOINT=http://minio:9000
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_ACCESS_KEY=vnshop
# OBJECT_STORAGE_SECRET_KEY=vnshop123
# OBJECT_STORAGE_BUCKET_PRODUCTS=vnshop-products
# OBJECT_STORAGE_PATH_STYLE=true

# MinIO root credentials. Override these (or shadow with a docker secret) in
# any shared environment — defaults are intentionally weak local-dev values.
# MINIO_ROOT_USER=vnshop
# MINIO_ROOT_PASSWORD=vnshop123

# --- Kafka SASL/PLAIN credentials ---
# Required — no default. Copy secrets.env.local (local dev) or inject via your
# secret manager (staging/prod). All values must be non-empty before starting.
KAFKA_ADMIN_PASSWORD=
KAFKA_SVC_ORDER_PASSWORD=
KAFKA_SVC_PAYMENT_PASSWORD=
KAFKA_SVC_INVENTORY_PASSWORD=
KAFKA_SVC_PRODUCT_PASSWORD=
KAFKA_SVC_SHIPPING_PASSWORD=
KAFKA_SVC_FINANCE_PASSWORD=
KAFKA_SVC_SEARCH_PASSWORD=
KAFKA_SVC_RECOMMENDATIONS_PASSWORD=
KAFKA_SVC_MESSAGING_PASSWORD=
# Passwords for the video pipeline services. Split per-service so that a single
# credential rotation doesn't affect both workers, and so the audit trail
# clearly attributes a leaked secret to one principal. ACLs already distinguish
# the two (see infra/scripts/init-kafka-topics.sh).
KAFKA_VIDEO_TRANSCODER_PASSWORD=
KAFKA_VIDEO_MODERATOR_PASSWORD=

# Broker identity used by messaging-service.
KAFKA_MESSAGING_PASSWORD=

# --- Elasticsearch ---
# Required — no default. Set a strong password; Elastic will refuse to start
# if this is blank (xpack.security.enabled=true).
ELASTIC_PASSWORD=

# ---------------------------------------------------------------------------
# External Provider Configuration
# ---------------------------------------------------------------------------
# Social OAuth providers (Google, Facebook). Set both CLIENT_ID and CLIENT_SECRET
# to enable. The *_ENABLED flags are optional — providers are disabled by default
# when credentials are absent.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
VNSHOP_FRONTEND_URL=http://localhost:3000
VNSHOP_AUTH_CALLBACK_BASE_URL=http://localhost:8080/auth/oauth/callback
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8080

# PayPal payment provider. Set CLIENT_ID and CLIENT_SECRET to enable.
# WEBHOOK_ID required for verifying payment events in production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Carrier API Credentials (shipping-service)
# ---------------------------------------------------------------------------
# Set CARRIER_MODE=stub for deterministic local pricing, or CARRIER_MODE=live
# with real GHN/GHTK credentials for production shipping rates.
# CARRIER_MODE=stub
CARRIER_MODE=stub
# GHN (Giao Hàng Nhanh) — https://dev.ghn.vn
GHN_TOKEN=
GHN_WEBHOOK_TOKEN=
GHN_SHOP_ID=
# GHTK (Giao Hàng Tiết Kiệm) — https://giaohangtietkiem.vn
GHTK_TOKEN=
GHTK_WEBHOOK_TOKEN=
GHTK_PARTNER_CODE=

# ---------------------------------------------------------------------------
# GeoIP Database (search-service)
# ---------------------------------------------------------------------------
# Path to MaxMind GeoLite2 database for IP-based location lookups.
# Download from https://www.maxmind.com/en/geoip2/geolite2-free-geolocation-data
# GEOIP_DATABASE_PATH=
