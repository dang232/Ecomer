{
  "name": "monitoring-service-v2",
  "version": "0.0.1",
  "private": true,
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.21.1",
    "brace-expansion": "5.0.9",
    "socket.io-parser": "4.2.7",
    "fast-uri": "3.1.5",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "cosmiconfig": {
      "js-yaml": "4.3.1"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  },
  "scripts": {
    "build": "node scripts/prepare-public-assets.mjs && nest build",
    "start": "node scripts/prepare-public-assets.mjs && nest start",
    "start:dev": "node scripts/prepare-public-assets.mjs && nest start --watch",
    "start:debug": "node scripts/prepare-public-assets.mjs && nest start --debug --watch",
    "start:prod": "node dist/main",
    "validate:openapi": "node ../../scripts/validate-openapi.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^5.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "axios": "^1.7.9",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "4.8.3",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
