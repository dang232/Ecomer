{
  "uid": "vnshop-saga-outbox-cache",
  "title": "VNShop Saga Outbox DLT Cache",
  "description": "Operational backlog, compensation, DLT, cache, and route RED signals.",
  "tags": ["vnshop", "saga", "outbox", "dlt", "cache", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "row", "title": "RED per route", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    { "id": 2, "type": "timeseries", "title": "Request rate by route", "gridPos": { "x": 0, "y": 1, "w": 12, "h": 7 }, "targets": [{ "expr": "sum by (job, route) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}} {{route}}", "refId": "A" }] },
    { "id": 3, "type": "timeseries", "title": "5xx ratio by route", "gridPos": { "x": 12, "y": 1, "w": 12, "h": 7 }, "targets": [{ "expr": "sum by (job, route) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (job, route) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}} {{route}}", "refId": "A" }] },
    { "id": 4, "type": "row", "title": "Saga / Outbox / DLT", "gridPos": { "x": 0, "y": 8, "w": 24, "h": 1 } },
    { "id": 5, "type": "timeseries", "title": "Outbox oldest age", "gridPos": { "x": 0, "y": 9, "w": 8, "h": 6 }, "targets": [{ "expr": "outbox_oldest_age_seconds", "legendFormat": "{{job}}", "refId": "A" }] },
    { "id": 6, "type": "timeseries", "title": "Saga compensation age and stuck orders", "gridPos": { "x": 8, "y": 9, "w": 8, "h": 6 }, "targets": [{ "expr": "saga_compensating_age_seconds", "legendFormat": "age {{job}}", "refId": "A" }, { "expr": "orders_stuck_compensating", "legendFormat": "stuck {{job}}", "refId": "B" }] },
    { "id": 7, "type": "timeseries", "title": "DLT oldest age", "gridPos": { "x": 16, "y": 9, "w": 8, "h": 6 }, "targets": [{ "expr": "dlt_age_seconds", "legendFormat": "{{job}}", "refId": "A" }] },
    { "id": 8, "type": "row", "title": "Cache and provider latency", "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 } },
    { "id": 9, "type": "timeseries", "title": "Redis evictions", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 }, "targets": [{ "expr": "sum by (job) (rate(redis_evictions_total[5m]))", "legendFormat": "{{job}}", "refId": "A" }] },
    { "id": 10, "type": "timeseries", "title": "Provider latency p95", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (job, le) (rate(provider_latency_seconds_bucket[5m])))", "legendFormat": "{{job}}", "refId": "A" }] }
  ]
}
