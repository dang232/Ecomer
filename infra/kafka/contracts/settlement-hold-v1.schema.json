{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settlement hold v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "subOrderId", "holdType", "open"],
  "properties": {
    "orderId": { "type": "string", "format": "uuid" },
    "subOrderId": { "type": ["integer", "null"], "minimum": 1 },
    "holdType": { "enum": ["RETURN", "DISPUTE", "FRAUD"] },
    "open": { "type": "boolean" }
  }
}
