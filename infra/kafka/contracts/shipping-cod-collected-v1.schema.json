{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipping COD collected v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "aggregateId", "correlationId", "causationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "SHIPPING_COD_COLLECTED" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "shipping-service" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectionId", "shipmentId", "orderId", "carrier", "amount", "currency", "collectedAt"],
      "properties": {
        "collectionId": { "type": "string", "format": "uuid" },
        "shipmentId": { "type": "string", "format": "uuid" },
        "orderId": { "type": "string", "format": "uuid" },
        "carrier": { "type": "string", "minLength": 1 },
        "amount": { "type": "integer", "minimum": 1 },
        "currency": { "const": "VND" },
        "collectedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
