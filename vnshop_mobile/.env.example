# VNShop Mobile - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# API Configuration
# ============================================================================
# Base URL for the API Gateway
# Local development: http://localhost:8080
# Docker network: http://host.docker.internal:8080
# Production: https://api.vnshop.com
API_BASE_URL=http://host.docker.internal:8080

# API Version prefix
API_VERSION=v1

# ============================================================================
# Keycloak / Authentication
# ============================================================================
# Keycloak URL
KEYCLOAK_URL=http://localhost:8085

# Keycloak Realm
KEYCLOAK_REALM=vnshop

# Keycloak Client ID
KEYCLOAK_CLIENT_ID=vnshop-api

# ============================================================================
# Firebase (Optional - for push notifications)
# ============================================================================
# Set to true when Firebase is configured
FIREBASE_ENABLED=false

# Firebase project ID (optional)
FIREBASE_PROJECT_ID=

# ============================================================================
# App Configuration
# ============================================================================
# App environment: development, staging, production
APP_ENV=development

# Enable mock data (bypasses real API)
USE_MOCK_BACKEND=false

# Enable verbose logging
DEBUG_LOGGING=false

# ============================================================================
# Payment Configuration (for reference)
# ============================================================================
# These are configured in the backend, not here
# VNPAY_ENABLED, MOMO_ENABLED, VIETQR_ENABLED, COD_ENABLED
