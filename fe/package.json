{
  "name": "vnshop-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "overrides": {
    "ws": "8.21.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 50",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "tokens:generate": "node ../scripts/generate-design-tokens.mjs",
    "tokens:check": "node --test ../scripts/generate-design-tokens.test.mjs",
    "lint:tokens": "npm run tokens:check && node scripts/check-design-tokens.mjs",
    "lint:all": "npm run lint && npm run lint:i18n && npm run lint:tokens",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.{ts,tsx}\"",
    "verify": "npm run typecheck && npm run lint && npm run lint:i18n && npm run lint:tokens && npm run format:check && npm run test && npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/hydrate-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "pretest:e2e:ui": "node scripts/hydrate-e2e.mjs",
    "test:a11y": "playwright test e2e/a11y.spec.ts"
  },
  "dependencies": {
    "@figma/astraui": "1.0.0",
    "@hookform/resolvers": "^3.9.1",
    "@paypal/react-paypal-js": "8.8.3",
    "@stripe/react-stripe-js": "3.7.0",
    "@stripe/stripe-js": "7.3.1",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "5.100.10",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "i18next": "26.2.0",
    "i18next-browser-languagedetector": "8.2.1",
    "libphonenumber-js": "^1.13.6",
    "lucide-react": "^1.17.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-i18next": "17.0.8",
    "react-router": "^7.15.0",
    "recharts": "2.15.2",
    "socket.io-client": "4.8.3",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "20.11.0",
    "prettier": "^3.4.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
