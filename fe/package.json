{
  "name": "vnshop-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "overrides": {
    "ws": "8.21.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "vite preview",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:test && pnpm run typecheck:e2e && pnpm run typecheck:node",
    "test": "vitest run",
    "test:release-workflows": "node --test scripts/check-release-workflows.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:type-safety": "node scripts/check-type-safety.mjs",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "tokens:generate": "node ../scripts/generate-design-tokens.mjs",
    "tokens:check": "node --test ../scripts/generate-design-tokens.test.mjs",
    "lint:tokens": "pnpm run tokens:check && node scripts/check-design-tokens.mjs",
    "lint:all": "pnpm run lint && pnpm run lint:i18n && pnpm run lint:tokens && pnpm run lint:type-safety && pnpm run lint:boundaries",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.{ts,tsx}\"",
    "verify": "pnpm run test:release-workflows && pnpm run typecheck && pnpm run lint:all && pnpm run format:check && pnpm run test && pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:modernization": "playwright test e2e/modernization --project=chromium",
    "test:e2e:local-complete": "playwright test --grep-invert @staging-contract",
    "test:e2e:assert-results": "node scripts/assert-playwright-results.mjs",
    "lint:e2e-credentials": "node scripts/check-e2e-credentials.mjs",
    "verify:e2e": "pnpm run lint:e2e-credentials && pnpm run typecheck:e2e",
    "pretest:e2e": "node scripts/hydrate-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "pretest:e2e:ui": "node scripts/hydrate-e2e.mjs",
    "test:a11y": "playwright test e2e/a11y.spec.ts e2e/modernization/accessibility.spec.ts",
    "test:visual": "playwright test e2e/modernization/visual-matrix.spec.ts",
    "test:states": "playwright test e2e/modernization/state-matrix.spec.ts",
    "test:text-scale": "playwright test e2e/modernization/text-scale.spec.ts",
    "measure:bundles": "node scripts/measure-route-bundles.mjs",
    "measure:lighthouse": "node scripts/measure-lighthouse.mjs",
    "measure:performance": "pnpm run build && pnpm run measure:bundles -- --output performance/current/route-bundles.json && pnpm run measure:lighthouse -- --output performance/current/lighthouse-mobile.json",
    "verify:performance": "node scripts/compare-performance.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@paypal/react-paypal-js": "8.8.3",
    "@stripe/react-stripe-js": "3.7.0",
    "@stripe/stripe-js": "7.3.1",
    "@tanstack/react-query": "5.101.4",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "i18next": "26.2.0",
    "i18next-browser-languagedetector": "8.2.1",
    "libphonenumber-js": "^1.13.6",
    "lucide-react": "^1.17.0",
    "motion": "12.23.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.55.0",
    "react-i18next": "17.0.8",
    "react-router": "^7.15.0",
    "recharts": "2.15.2",
    "socket.io-client": "4.8.3",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "chrome-launcher": "1.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "20.11.0",
    "lighthouse": "13.4.1",
    "prettier": "^3.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "4.1.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
